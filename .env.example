# Salin file ini menjadi .env, lalu isi API key dari Google AI Studio
# (tanpa tanda kutip, karena docker --env-file tidak membuang kutip)
GEMINI_API_KEY=

# Opsional: urutan model LLM, dicoba satu per satu kalau model sebelumnya gagal (misal 503)
# LLM_MODELS=gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.6-flash

# Opsional: model embedding untuk knowledge base dan query
# EMBED_MODEL=gemini-embedding-001

# Opsional: skor kemiripan minimum (0-1), di bawah ini pertanyaan dianggap tidak ada di knowledge base
# MIN_SCORE=0.73
